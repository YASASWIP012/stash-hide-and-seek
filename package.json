{
  "name": "stash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "pipeline": "node --experimental-strip-types scripts/pipeline.ts",
    "ledger": "node --experimental-strip-types scripts/ledger.ts"
  },
  "dependencies": {
    "@manycore/aholo-viewer": "^1.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vercel/node": "^31.0.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
