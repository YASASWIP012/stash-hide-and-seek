{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.ts": { "maxDuration": 30 } },
  "headers": [
    { "source": "/objects/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/rooms/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
